import { ThemeColors } from "types.slint";

component DockTabPill inherits Rectangle {
    in property <ThemeColors> theme;
    in property <string> label;
    in property <string> icon-path;
    in property <bool> active;
    in property <length> pill-width;

    width: root.pill-width;
    height: 30px;
    y: 11px;
    border-radius: 15px;
    background: root.active ? root.theme.accent : transparent;
    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        Rectangle {
            width: 14px; height: 30px;
            Path {
                x: 0px; y: 8px; width: 14px; height: 14px;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
                commands: root.icon-path;
                stroke: root.active ? root.theme.accent-fg : root.theme.muted;
                stroke-width: 2px;
            }
        }
        Text {
            text: root.label;
            color: root.active ? root.theme.accent-fg : root.theme.muted;
            font-size: 12px; font-weight: 700; vertical-alignment: center;
        }
    }
}

export component BottomDock inherits Rectangle {
    in property <ThemeColors> theme;
    in property <string> dock-tab;
    in property <float> now-progress;
    in property <string> battery-label;

    height: 56px;
    width: 640px;
    background: root.theme.dock;

    VerticalLayout {
        spacing: 0px;
        // 4px Progress Hairline
        Rectangle {
            height: 4px;
            background: root.theme.card2;
            Rectangle {
                x: 0px;
                y: 0px;
                height: 4px;
                width: parent.width * max(0.0, min(1.0, root.now-progress));
                background: root.theme.accent;
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            vertical-stretch: 1;

            DockTabPill {
                theme: root.theme;
                label: "Now";
                icon-path: "M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18z M10 8l6 4-6 4z";
                active: root.dock-tab == "now";
                pill-width: 78px;
            }
            DockTabPill {
                theme: root.theme;
                label: "Vibes";
                icon-path: "M9 18V5l12-2v13 M6 15a3 3 0 1 0 0 6 3 3 0 1 0 0-6z M18 13a3 3 0 1 0 0 6 3 3 0 1 0 0-6z";
                active: root.dock-tab == "vibes";
                pill-width: 84px;
            }
            DockTabPill {
                theme: root.theme;
                label: "Artists";
                icon-path: "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 3a4 4 0 1 0 0 8 4 4 0 1 0 0-8z";
                active: root.dock-tab == "artists";
                pill-width: 90px;
            }
            DockTabPill {
                theme: root.theme;
                label: "Home";
                icon-path: "M3 10.5L12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z";
                active: root.dock-tab == "lib";
                pill-width: 82px;
            }
            DockTabPill {
                theme: root.theme;
                label: "Find";
                icon-path: "M11 4a7 7 0 1 0 0 14 7 7 0 1 0 0-14z M21 21l-4.35-4.35";
                active: root.dock-tab == "find";
                pill-width: 78px;
            }

            Rectangle { horizontal-stretch: 1; }

            // Aligned Battery Icon + Percentage
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 18px;
                    height: 52px;
                    Path {
                        x: 0px;
                        y: 18px;
                        width: 18px;
                        height: 16px;
                        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
                        commands: "M2 7h16v10H2z M21 10v4 M4.5 9.5h10v5h-10z";
                        stroke: root.theme.ok;
                        stroke-width: 2px;
                    }
                }
                Text {
                    text: root.battery-label;
                    color: root.theme.text;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }
}
