import { MarqueeText, PlaylistRow, ThemeColors, TrackListRow, TrackRow } from "types.slint";

export component LibraryView inherits VerticalLayout {
    in property <ThemeColors> theme;
    in property <string> lib-mode;
    in property <string> lib-filter;
    in property <bool> filter-focused: false;
    in property <string> lib-downloads-info;
    in property <[PlaylistRow]> playlists;
    in property <int> playlist-index;
    in property <bool> lib-focus-playlists;
    in property <bool> detail-top-focused;
    in property <[TrackRow]> list-rows;
    in property <int> list-index;
    in property <int> list-scroll;

    padding: 14px;
    spacing: 8px;

    HorizontalLayout {
        height: 30px;
        spacing: 6px;
        for m in [
            { id: "favs", label: "♥ Favs" },
            { id: "playlists", label: "Playlists" },
            { id: "history", label: "History" },
            { id: "downloads", label: "↓ Downloads" },
        ] : Rectangle {
            width: m-lbl.preferred-width + 18px;
            border-radius: 10px;
            border-width: 1px;
            border-color: root.lib-mode == m.id ? root.theme.accent : root.theme.border;
            background: root.lib-mode == m.id ? root.theme.accent : root.theme.card;
            m-lbl := Text {
                text: m.label;
                color: root.lib-mode == m.id ? root.theme.accent-fg : root.theme.text;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.lib-mode == "downloads" : Rectangle {
            width: clr-t.preferred-width + 14px;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.detail-top-focused ? root.theme.heart : root.theme.border;
            background: root.detail-top-focused ? root.theme.heart : root.theme.card;
            clr-t := Text {
                text: root.lib-downloads-info == "" ? "🗑 Clear All" : ("🗑 " + root.lib-downloads-info);
                color: root.detail-top-focused ? #ffffff : root.theme.text;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.lib-mode != "downloads" : Text {
            text: "R-Stk ◀▶ Tabs";
            color: root.theme.muted;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    // Home Search Bar (filters History, Downloads, Favorites, Playlists)
    Rectangle {
        height: 30px;
        border-radius: 10px;
        background: root.filter-focused ? root.theme.card2 : root.theme.card;
        border-width: root.filter-focused ? 2px : 1px;
        border-color: root.filter-focused ? root.theme.accent : (root.lib-filter != "" ? root.theme.accent : root.theme.border);

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Path {
                width: 13px;
                height: 13px;
                y: 8.5px;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
                commands: "M11 4a7 7 0 1 0 0 14 7 7 0 1 0 0-14z M21 21l-4.35-4.35";
                stroke: root.filter-focused ? root.theme.accent : root.theme.muted;
                stroke-width: 2.2px;
            }
            Text {
                horizontal-stretch: 1;
                text: root.lib-filter == ""
                    ? (root.filter-focused ? "Press A to open keyboard..." : "▲ / R3: Search history, downloads & favorites...")
                    : ("Filter: " + root.lib-filter);
                color: root.filter-focused ? root.theme.accent : (root.lib-filter == "" ? root.theme.muted : root.theme.text);
                font-size: 11px;
                font-weight: root.lib-filter != "" || root.filter-focused ? 700 : 500;
                vertical-alignment: center;
            }
            if root.lib-filter != "" : Text {
                text: root.filter-focused ? "X: Clear" : "Filtered";
                color: root.theme.accent;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    if root.lib-mode == "playlists" : HorizontalLayout {
        vertical-stretch: 1;
        spacing: 10px;

        // Left Playlists Rail
        Rectangle {
            width: 184px;
            background: root.theme.card;
            border-width: 1px;
            border-color: root.lib-focus-playlists ? root.theme.accent : root.theme.border;
            border-radius: 14px;
            clip: true;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                for pl[pi] in root.playlists : Rectangle {
                    height: 36px;
                    border-radius: 10px;
                    background: root.playlist-index == pi ? root.theme.accent : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: pl.name;
                            color: root.playlist-index == pi ? root.theme.accent-fg : root.theme.text;
                            font-size: 12px;
                            font-weight: 700;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: pl.count_label;
                            color: root.playlist-index == pi ? root.theme.accent-fg : root.theme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Right Playlist Tracks
        Rectangle {
            horizontal-stretch: 1;
            background: root.theme.card;
            border-width: 1px;
            border-color: !root.lib-focus-playlists ? root.theme.accent : root.theme.border;
            border-radius: 14px;
            clip: true;

            if root.list-rows.length == 0 : Text {
                text: "Playlist empty.\nPress START on any song to add it!";
                color: root.theme.muted;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            for tr[idx] in root.list-rows : Rectangle {
                property <bool> sel: !root.lib-focus-playlists && root.list-index == idx;
                x: 0px;
                y: (idx - root.list-scroll) * 50px;
                width: parent.width;
                height: 50px;
                visible: idx >= root.list-scroll && (idx - root.list-scroll) < 6;
                background: sel ? root.theme.card2 : transparent;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        MarqueeText {
                            text: tr.title;
                            text-color: sel ? root.theme.accent : root.theme.text;
                            font-size: 12px;
                            font-weight: 700;
                            active: sel;
                        }
                        Text {
                            text: tr.artist;
                            color: root.theme.muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: tr.is_offline ? "✓" : tr.duration;
                        color: tr.is_offline ? root.theme.ok : root.theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    x: 0px;
                    y: 49px;
                    width: parent.width;
                    height: 1px;
                    background: root.theme.border;
                }
            }
        }
    }

    if root.lib-mode != "playlists" : Rectangle {
        vertical-stretch: 1;
        background: root.theme.card;
        border-width: 1px;
        border-color: root.theme.border;
        border-radius: 16px;
        clip: true;

        if root.list-rows.length == 0 : Text {
            text: root.lib-filter != ""
                ? "No tracks match \"" + root.lib-filter + "\" (R3 to edit filter)"
                : (root.lib-mode == "favs"
                    ? "No favorites yet. Press X on any track!"
                    : (root.lib-mode == "history"
                        ? "No playback history yet. Play a song to record it!"
                        : "No downloads yet. Press Y on any track!"));
            color: root.theme.muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        for tr[idx] in root.list-rows : TrackListRow {
            width: parent.width;
            theme: root.theme;
            tr: tr;
            idx: idx;
            list-index: root.list-index;
            list-scroll: root.list-scroll;
            detail-top-focused: root.detail-top-focused;
            show-playing-prefix: false;
        }
    }

    Text {
        text: root.lib-mode == "downloads"
            ? "A: Play · X: Fav · Y: 🗑 Delete · ▲ Top: Clear All · R3: Filter · R-Stk ◀▶: Tab"
            : "A: Play · X: Fav · Y: DL · START: +List · R3: Filter · R-Stk ◀▶: Tab";
        color: root.theme.muted;
        font-size: 10px;
        horizontal-alignment: center;
    }
}
