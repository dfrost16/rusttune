import "../../port/assets/fonts/Inter-Regular.ttf";
import "../../port/assets/fonts/Inter-Bold.ttf";

import { GridCard, PlaylistRow, ThemeColors, TrackRow } from "types.slint";
import { NowPlayingView } from "now_view.slint";
import { ArtistsGridView, VibesGridView } from "grids_view.slint";
import { ArtistDetailView, CollectionDetailView } from "details_view.slint";
import { LibraryView } from "library_view.slint";
import { FindView } from "find_view.slint";
import { BottomDock } from "dock.slint";
import {
    ConfirmModal,
    GridKeyboardModal,
    PlaylistModal,
    PocketLockOverlay,
    SettingsModal,
    ToastBanner,
} from "overlays.slint";

export { TrackRow, GridCard, PlaylistRow }

export component YtMusicWindow inherits Window {
    width: 640px;
    height: 480px;
    default-font-family: "Inter";

    // Theme tokens (Studio Dark default; swapped dynamically for Studio Light / album accent)
    in-out property <color> c-bg: #0e1014;
    in-out property <color> c-card: #161922;
    in-out property <color> c-card2: #1f2430;
    in-out property <color> c-dock: #11131a;
    in-out property <color> c-border: #2a303f;
    in-out property <color> c-text: #f3f4f6;
    in-out property <color> c-muted: #9ca3af;
    in-out property <color> c-accent: #bef264;
    in-out property <color> c-accent-fg: #0f172a;
    in-out property <color> c-heart: #fb7185;
    in-out property <color> c-ok: #4ade80;
    in-out property <image> bg-dots;

    property <ThemeColors> theme: {
        bg: root.c-bg,
        card: root.c-card,
        card2: root.c-card2,
        dock: root.c-dock,
        border: root.c-border,
        text: root.c-text,
        muted: root.c-muted,
        accent: root.c-accent,
        accent-fg: root.c-accent-fg,
        heart: root.c-heart,
        ok: root.c-ok,
    };

    // Top-level screen state
    // "now" | "vibes" | "vibe_detail" | "artists" | "artist_detail" | "album_detail" | "lib" | "find"
    in-out property <string> active-tab: "now";
    in-out property <string> dock-tab: "now";

    // Now Playing
    in-out property <string> now-title: "Ready to Play";
    in-out property <string> now-artist: "Pick a Vibe, Artist, or Search";
    in-out property <bool> now-artist-focused: false;
    in-out property <string> now-album: "";
    in-out property <string> now-genre: "YT MUSIC";
    in-out property <string> now-elapsed: "0:00";
    in-out property <string> now-duration: "0:00";
    in-out property <string> now-format: "AAC 128k";
    in-out property <float> now-progress: 0.0;
    in-out property <bool> is-playing: false;
    in-out property <bool> is-favorite-now: false;
    in-out property <bool> is-offline-now: false;
    in-out property <image> cover-art;
    in-out property <bool> has-cover-art: false;

    // 3-line lyrics below album art
    in-out property <string> lyric-prev: "";
    in-out property <string> lyric-curr: "Select a track to view lyrics";
    in-out property <string> lyric-next: "";

    // Up Next + Playlist preview on Now Playing right column
    in-out property <string> next-title: "—";
    in-out property <string> next-artist: "";
    in-out property <string> next-duration: "";
    in-out property <string> playlist-label: "PLAYLIST: UP NEXT";
    in-out property <[TrackRow]> now-playlist-rows: [];

    // Grids (Vibes & Artists)
    in-out property <[GridCard]> vibe-cards: [];
    in-out property <int> vibe-index: 0;
    in-out property <int> vibe-row-scroll: 0;
    in-out property <bool> vibe-fav-only: false;
    in-out property <string> vibe-filter: "";

    in-out property <[GridCard]> artist-cards: [];
    in-out property <int> artist-index: 0;
    in-out property <int> artist-row-scroll: 0;
    in-out property <bool> artist-fav-only: false;
    in-out property <string> artist-filter: "";
    in-out property <string> artist-page-label: "Page 1/1";

    in-out property <bool> grid-kbd-open: false;
    in-out property <string> grid-kbd-title: "SEARCH ARTISTS";
    in-out property <[GridCard]> grid-kbd-previews: [];

    // Detail & Library track lists
    in-out property <string> detail-title: "";
    in-out property <string> detail-subtitle: "";
    in-out property <string> detail-count-label: "";
    in-out property <string> artist-kicker: "ARTIST";
    in-out property <string> artist-stats: "";
    in-out property <int> artist-section: 0; // 0 = Top Songs, 1 = Albums, 2 = Singles & EPs
    in-out property <int> artist-songs-count: 0;
    in-out property <int> artist-albums-count: 0;
    in-out property <int> artist-singles-count: 0;
    in-out property <color> detail-accent: #bef264;
    in-out property <bool> detail-is-fav: false;
    in-out property <bool> detail-top-focused: false;
    in-out property <image> detail-thumb;
    in-out property <bool> has-detail-thumb: false;
    in-out property <[TrackRow]> list-rows: [];
    in-out property <int> list-index: 0;
    in-out property <int> list-scroll: 0;

    // Home (Library)
    in-out property <string> lib-mode: "favs"; // "favs" | "playlists" | "history" | "downloads"
    in-out property <string> lib-filter: "";
    in-out property <bool> filter-focused: false;
    in-out property <string> lib-downloads-info: "";
    in-out property <[PlaylistRow]> playlists: [];
    in-out property <int> playlist-index: 0;
    in-out property <bool> lib-focus-playlists: true;

    // Find (QWERTY + 123 Numbers + Autocomplete + Live Hits)
    in-out property <string> search-query: "";
    in-out property <int> find-zone: 2; // 0 = suggestions, 1 = live hits, 2 = keyboard
    in-out property <int> chip-index: 0;
    in-out property <[string]> suggest-chips: [];
    in-out property <[TrackRow]> find-hits: [];
    in-out property <int> find-hit-index: 0;
    in-out property <int> find-hit-scroll: 0;
    in-out property <int> key-row: 0;
    in-out property <int> key-col: 0;
    in-out property <bool> kbd-num-mode: false;
    in-out property <[string]> qwerty-keys: [
        "Q","W","E","R","T","Y","U","I","O","P",
        "A","S","D","F","G","H","J","K","L","DEL",
        "Z","X","C","V","B","N","M","SPC","123","GO"
    ];
    in-out property <[string]> num-keys: [
        "1","2","3","4","5","6","7","8","9","0",
        "-","_","/",".",":","&","!","?","'","DEL",
        "@","#","(",")","+","=","SPC","CLR","ABC","GO"
    ];

    // Confirm Modal (Batch Download / Clear Downloads)
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-title: "";
    in-out property <string> confirm-body: "";
    in-out property <string> confirm-yes-label: "Confirm";

    // System & Modals
    in-out property <bool> light-mode: false;
    in-out property <string> battery-label: "84%";
    in-out property <float> battery-pct: 0.84;
    in-out property <string> clock-h1: "0";
    in-out property <string> clock-h2: "0";
    in-out property <string> clock-m1: "0";
    in-out property <string> clock-m2: "0";
    in-out property <string> remote-url: "http://127.0.0.1:8080";
    in-out property <bool> pocket-lock: false;
    in-out property <string> toast-text: "";

    in-out property <bool> pl-modal-open: false;
    in-out property <int> pl-modal-index: 0;

    in-out property <bool> settings-open: false;
    in-out property <int> settings-index: 0;
    in-out property <bool> web-server-on: true;
    in-out property <string> web-pin-label: "";
    in-out property <string> theme-label: "Studio Dark";
    in-out property <bool> loop-track: false;
    in-out property <bool> radio-autoplay: true;
    in-out property <bool> swap-ab: false;

    Rectangle {
        width: 640px;
        height: 480px;
        background: root.c-bg;

        Image {
            width: 640px;
            height: 480px;
            source: root.bg-dots;
        }

        VerticalLayout {
            spacing: 0px;

            // Main Canvas (424px)
            Rectangle {
                height: 424px;
                width: 640px;
                background: transparent;

                if root.active-tab == "now" : NowPlayingView {
                    theme: root.theme;
                    active: true;
                    cover-art: root.cover-art;
                    has-cover-art: root.has-cover-art;
                    is-playing: root.is-playing;
                    is-favorite-now: root.is-favorite-now;
                    is-offline-now: root.is-offline-now;
                    loop-track: root.loop-track;
                    now-title: root.now-title;
                    now-artist: root.now-artist;
                    now-artist-focused: root.now-artist-focused;
                    now-album: root.now-album;
                    now-genre: root.now-genre;
                    now-elapsed: root.now-elapsed;
                    now-duration: root.now-duration;
                    now-format: root.now-format;
                    lyric-prev: root.lyric-prev;
                    lyric-curr: root.lyric-curr;
                    lyric-next: root.lyric-next;
                    next-title: root.next-title;
                    next-artist: root.next-artist;
                    next-duration: root.next-duration;
                    playlist-label: root.playlist-label;
                    now-playlist-rows: root.now-playlist-rows;
                }

                if root.active-tab == "vibes" : VibesGridView {
                    theme: root.theme;
                    vibe-cards: root.vibe-cards;
                    vibe-index: root.vibe-index;
                    vibe-row-scroll: root.vibe-row-scroll;
                    vibe-fav-only: root.vibe-fav-only;
                    vibe-filter: root.vibe-filter;
                    filter-focused: root.filter-focused;
                }

                if root.active-tab == "artists" : ArtistsGridView {
                    theme: root.theme;
                    artist-cards: root.artist-cards;
                    artist-index: root.artist-index;
                    artist-row-scroll: root.artist-row-scroll;
                    artist-fav-only: root.artist-fav-only;
                    artist-filter: root.artist-filter;
                    artist-page-label: root.artist-page-label;
                    filter-focused: root.filter-focused;
                }

                if root.active-tab == "vibe_detail" || root.active-tab == "album_detail" : CollectionDetailView {
                    theme: root.theme;
                    active-tab: root.active-tab;
                    detail-title: root.detail-title;
                    detail-subtitle: root.detail-subtitle;
                    detail-count-label: root.detail-count-label;
                    detail-accent: root.detail-accent;
                    detail-top-focused: root.detail-top-focused;
                    detail-thumb: root.detail-thumb;
                    has-detail-thumb: root.has-detail-thumb;
                    list-rows: root.list-rows;
                    list-index: root.list-index;
                    list-scroll: root.list-scroll;
                }

                if root.active-tab == "artist_detail" : ArtistDetailView {
                    theme: root.theme;
                    active: true;
                    artist-kicker: root.artist-kicker;
                    detail-title: root.detail-title;
                    artist-stats: root.artist-stats;
                    detail-count-label: root.detail-count-label;
                    detail-accent: root.detail-accent;
                    detail-is-fav: root.detail-is-fav;
                    detail-top-focused: root.detail-top-focused;
                    detail-thumb: root.detail-thumb;
                    has-detail-thumb: root.has-detail-thumb;
                    artist-section: root.artist-section;
                    artist-songs-count: root.artist-songs-count;
                    artist-albums-count: root.artist-albums-count;
                    artist-singles-count: root.artist-singles-count;
                    list-rows: root.list-rows;
                    list-index: root.list-index;
                    list-scroll: root.list-scroll;
                }

                if root.active-tab == "lib" : LibraryView {
                    theme: root.theme;
                    lib-mode: root.lib-mode;
                    lib-filter: root.lib-filter;
                    filter-focused: root.filter-focused;
                    lib-downloads-info: root.lib-downloads-info;
                    playlists: root.playlists;
                    playlist-index: root.playlist-index;
                    lib-focus-playlists: root.lib-focus-playlists;
                    detail-top-focused: root.detail-top-focused;
                    list-rows: root.list-rows;
                    list-index: root.list-index;
                    list-scroll: root.list-scroll;
                }

                if root.active-tab == "find" : FindView {
                    theme: root.theme;
                    search-query: root.search-query;
                    remote-url: root.remote-url;
                    web-server-on: root.web-server-on;
                    web-pin-label: root.web-pin-label;
                    find-zone: root.find-zone;
                    chip-index: root.chip-index;
                    suggest-chips: root.suggest-chips;
                    find-hits: root.find-hits;
                    find-hit-index: root.find-hit-index;
                    find-hit-scroll: root.find-hit-scroll;
                    key-row: root.key-row;
                    key-col: root.key-col;
                    kbd-num-mode: root.kbd-num-mode;
                    qwerty-keys: root.qwerty-keys;
                    num-keys: root.num-keys;
                }
            }

            BottomDock {
                visible: !root.pocket-lock;
                theme: root.theme;
                dock-tab: root.dock-tab;
                now-progress: root.now-progress;
                battery-label: root.battery-label;
            }
        }

        if root.grid-kbd-open : GridKeyboardModal {
            theme: root.theme;
            active-tab: root.active-tab;
            grid-kbd-title: root.grid-kbd-title;
            vibe-filter: root.vibe-filter;
            lib-filter: root.lib-filter;
            artist-filter: root.artist-filter;
            grid-kbd-previews: root.grid-kbd-previews;
            qwerty-keys: root.qwerty-keys;
            num-keys: root.num-keys;
            kbd-num-mode: root.kbd-num-mode;
            key-row: root.key-row;
            key-col: root.key-col;
        }

        if root.pl-modal-open : PlaylistModal {
            theme: root.theme;
            playlists: root.playlists;
            pl-modal-index: root.pl-modal-index;
        }

        if root.settings-open : SettingsModal {
            theme: root.theme;
            settings-index: root.settings-index;
            theme-label: root.theme-label;
            loop-track: root.loop-track;
            radio-autoplay: root.radio-autoplay;
            swap-ab: root.swap-ab;
            web-server-on: root.web-server-on;
            remote-url: root.remote-url;
            web-pin-label: root.web-pin-label;
        }

        if root.confirm-open : ConfirmModal {
            theme: root.theme;
            confirm-title: root.confirm-title;
            confirm-body: root.confirm-body;
            confirm-yes-label: root.confirm-yes-label;
        }

        if root.toast-text != "" && !root.pocket-lock : ToastBanner {
            theme: root.theme;
            toast-text: root.toast-text;
        }

        if root.pocket-lock : PocketLockOverlay {
            x: 0px;
            y: 0px;
            light-mode: root.light-mode;
            clock-h1: root.clock-h1;
            clock-h2: root.clock-h2;
            clock-m1: root.clock-m1;
            clock-m2: root.clock-m2;
            battery-label: root.battery-label;
            battery-pct: root.battery-pct;
            now-title: root.now-title;
            now-progress: root.now-progress;
            now-elapsed: root.now-elapsed;
            now-duration: root.now-duration;
        }
    }
}
